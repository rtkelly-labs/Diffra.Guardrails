{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expected findings for one dependency-policy conformance case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case", "summary", "today", "exit", "findings"],
  "properties": {
    "case": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9-]+$" },
    "summary": { "type": "string", "minLength": 1 },
    "today": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "exit": { "type": "integer", "enum": [0, 1, 2] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "path", "package", "version", "via"],
        "properties": {
          "rule": { "type": "string", "enum": ["DFG601", "DFG602"] },
          "path": { "type": "string", "minLength": 1 },
          "package": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "via": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
